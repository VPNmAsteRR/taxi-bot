# Скопируйте этот файл в .env и заполните своими значениями.
# Токены двух ботов из @BotFather
PASSENGER_BOT_TOKEN=123456789:AA...
DRIVER_BOT_TOKEN=987654321:BB...

# Тариф: посадка + включённые километры + цена за км сверх них.
# Бот показывает эти условия в карточке заказа и не спрашивает км у пассажира.
BASE_FARE=250
INCLUDED_KM=2
PRICE_PER_KM=50

# Код для регистрации водителей. Для рабочего бота не оставляйте пустым.
# Регистр важен: TAXiDrivEE и taxidrivee — разные коды.
DRIVER_INVITE_CODE=TAXiDrivEE

# Код для входа в админку. Обязательно замените на свой.
# Регистр важен. Пустое значение полностью отключает админку.
ADMIN_INVITE_CODE=TAXI-ADMIN-2026

# Штраф за отмену заказа, который водитель уже принял. 0 — без штрафов.
FINE_AMOUNT=150

# Telegram ID владельца: сюда приходят PDF-чеки по штрафам.
# Доступ пассажиру открывается автоматически, чек — просто для сведения.
OWNER_ID=

# Где хранить SQLite. Для Docker внутри контейнера используется /data.
DATA_DIR=./data

# Обычно менять не нужно
API_BASE=https://api.telegram.org
TZ=Europe/Moscow
PYTHONUNBUFFERED=1
